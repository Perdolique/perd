{
  "name": "perd",
  "private": true,
  "type": "module",
  "imports": {
    "#server/*": "./server/*.ts",
    "#shared/*": "./shared/*.ts"
  },
  "scripts": {
    "build": "nuxt build",
    "build:e2e": "nuxt build --dotenv tests/playwright/runtime.env",
    "cf-typegen": "wrangler types server/types/worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "tsx --env-file=.env ./tools/migrate.ts",
    "db:migrate": "tsx ./tools/migrate.ts",
    "db:reset:catalog": "tsx ./tools/reset-catalog.ts",
    "db:reset:catalog:local": "tsx --env-file=.env ./tools/reset-catalog.ts",
    "deploy:production": "wrangler deploy --env=production",
    "deploy:staging": "wrangler deploy --env=staging",
    "deploy:versions:staging": "wrangler versions upload --env=staging",
    "dev": "nuxt dev",
    "drizzle": "drizzle-kit",
    "format": "worsier --write .",
    "format:check": "worsier --check .",
    "lint:markdown": "markdownlint '**/*.md'",
    "lint:oxlint": "oxlint",
    "lint:oxlint:agent": "oxlint --format agent",
    "postinstall": "nuxt prepare",
    "preview": "wrangler dev",
    "preview:e2e": "XDG_CONFIG_HOME=.output/e2e/config XDG_CACHE_HOME=.output/e2e/cache XDG_STATE_HOME=.output/e2e/state WRANGLER_LOG_PATH=.output/e2e/logs WRANGLER_CACHE_DIR=.output/e2e/cache/wrangler wrangler dev --local --env-file tests/playwright/runtime.env --persist-to .output/e2e/wrangler-state --ip 127.0.0.1 --port 8888 --log-level warn",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:ci": "CI=true playwright test",
    "test:typecheck": "nuxi typecheck",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run",
    "test:unit:agent": "vitest run --reporter agent",
    "update:all": "taze --interactive --include-locked",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxt/hints": "1.1.4",
    "@nuxt/image": "2.1.0",
    "@pinia/nuxt": "1.0.2",
    "delay": "7.0.0",
    "nuxt": "4.5.2",
    "pinia": "4.0.3",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@iconify-json/hugeicons": "1.2.33",
    "@neondatabase/serverless": "1.1.0",
    "@nuxt/devtools": "3.4.2",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.5.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.3.0",
    "@types/ws": "8.18.1",
    "@vueuse/core": "14.4.0",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "drizzle-seed": "1.0.0-rc.4",
    "eslint-config-greenpie": "17.8.0",
    "husky": "9.1.7",
    "markdownlint": "0.41.1",
    "markdownlint-cli": "0.49.1",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "taze": "21.1.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "ufo": "1.6.4",
    "valibot": "1.4.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11",
    "worsier": "3.0.1",
    "wrangler": "4.113.0",
    "ws": "8.21.3"
  },
  "packageManager": "pnpm@11.24.0"
}
